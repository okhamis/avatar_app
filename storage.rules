rules_version = '2';

// Deploy: Firebase Console → Storage → Rules, or: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // User avatars: only the signed-in user can read/write their own files under avatars/{uid}/
    match /avatars/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
