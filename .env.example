# Presnt API Keys

# Which model answers in Live Conversation: gemini (default) or claude
BEHAVIOR_LLM=gemini

GEMINI_API_KEY=your_gemini_api_key_here
# Optional override (default gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic — used when BEHAVIOR_LLM=claude
CLAUDE_API_KEY=your_claude_api_key_here
# Optional override; default from AppConfig when unset in .env
# CLAUDE_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_MESSAGES_URL=https://api.anthropic.com/v1/messages
# ANTHROPIC_VERSION=2023-06-01
# CLAUDE_MAX_TOKENS=300

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_TTS_BASE_URL=https://api.elevenlabs.io/v1/text-to-speech
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_monolingual_v1
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.5

HEYGEN_API_KEY=your_heygen_api_key_here
# Required for createStreamingSession(); leave unset to skip streaming until configured
# HEYGEN_STREAMING_AVATAR_NAME=your_heygen_streaming_avatar_id
# HEYGEN_STREAMING_NEW_URL=https://api.heygen.com/v1/streaming.new
# HEYGEN_STREAMING_TASK_URL=https://api.heygen.com/v1/streaming.task
# HEYGEN_STREAMING_STOP_URL=https://api.heygen.com/v1/streaming.stop
# HEYGEN_STREAMING_QUALITY=high
# HEYGEN_TASK_TYPE=text

# Firebase emulator (debug builds read these after dotenv.load)
# USE_FIREBASE_EMULATOR=true
# AUTH_EMULATOR_HOST=127.0.0.1
# AUTH_EMULATOR_PORT=9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1
# FIRESTORE_EMULATOR_PORT=8080

# Firestore / Storage paths (defaults: users, avatars)
# FIRESTORE_USERS_COLLECTION=users
# FIRESTORE_AVATARS_COLLECTION=avatars
# STORAGE_AVATARS_ROOT=avatars

# Onboarding
# FACE_UPLOAD_MIN=5
# FACE_UPLOAD_MAX=10

# Optional stock portrait when user has no preview (empty = icon only)
# APP_PLACEHOLDER_PORTRAIT_URL=
