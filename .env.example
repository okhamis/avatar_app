# Presnt API Keys

# --- Secure live chat (recommended for production) ---
# 1) cd functions && npm install
# 2) firebase functions:secrets:set GEMINI_API_KEY
# 3) firebase deploy --only functions
# 4) In this file (local .env): USE_BACKEND_LLM=true  and  CLOUD_FUNCTIONS_REGION=us-central1
# Requires Firebase Auth sign-in. Server runs Gemini; you can omit GEMINI_API_KEY on the client when this is on.
# Local emulator: firebase emulators:start --only functions  then  USE_FUNCTIONS_EMULATOR=true

# Which model answers in Live Conversation: gemini (default) or claude
# (Ignored when USE_BACKEND_LLM=true — server always uses Gemini.)
BEHAVIOR_LLM=gemini

# From https://aistudio.google.com/app/apikey — value usually starts with AIza (not gen-lang-client-...)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional override (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic — used when BEHAVIOR_LLM=claude
CLAUDE_API_KEY=your_claude_api_key_here
# Optional override; default from AppConfig when unset in .env
# CLAUDE_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_MESSAGES_URL=https://api.anthropic.com/v1/messages
# ANTHROPIC_VERSION=2023-06-01
# CLAUDE_MAX_TOKENS=300

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_TTS_BASE_URL=https://api.elevenlabs.io/v1/text-to-speech
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_monolingual_v1
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.5

HEYGEN_API_KEY=your_heygen_api_key_here
# Optional: Fallback Interactive Avatar id for streaming.new when user has no custom photo avatar.
# HEYGEN_STREAMING_AVATAR_ID=your_interactive_avatar_id
# Legacy alias (same value as AVATAR_ID):
# HEYGEN_STREAMING_AVATAR_NAME=your_interactive_avatar_id
# HEYGEN_STREAMING_NEW_URL=https://api.heygen.com/v1/streaming.new
# HEYGEN_STREAMING_TASK_URL=https://api.heygen.com/v1/streaming.task
# HEYGEN_STREAMING_STOP_URL=https://api.heygen.com/v1/streaming.stop
# HEYGEN_STREAMING_AVATAR_LIST_URL=https://api.heygen.com/v1/streaming/avatar.list
# HEYGEN_STREAMING_QUALITY=high
# HEYGEN_TASK_TYPE=text
# HEYGEN_USE_STORED_FACE_FOR_STREAMING=false
# Photo Avatar endpoints (face clone pipeline)
# HEYGEN_UPLOAD_ASSET_URL=https://upload.heygen.com/v1/asset
# HEYGEN_PHOTO_AVATAR_GROUP_CREATE_URL=https://api.heygen.com/v2/photo_avatar/avatar_group/create
# HEYGEN_PHOTO_AVATAR_GROUP_ADD_URL=https://api.heygen.com/v2/photo_avatar/avatar_group/add

# LiveAvatar — replaces HeyGen Streaming Avatar (set LIVEAVATAR_ENABLED=true to use)
# LIVEAVATAR_ENABLED=false
# LIVEAVATAR_API_KEY=your_liveavatar_api_key
# LIVEAVATAR_AVATAR_ID=00000000-0000-0000-0000-000000000000
# LIVEAVATAR_API_BASE=https://api.liveavatar.com
# LIVEAVATAR_SANDBOX=false
# LIVEAVATAR_VIDEO_QUALITY=high
# LIVEAVATAR_VIDEO_ENCODING=H264

# D-ID Agents Streaming (default live provider in app Settings → Live video provider)
# Uses the Agents API: POST /agents/{agentId}/streams (not the legacy /talks/streams).
#
# Setup steps:
#   1. Go to https://studio.d-id.com/agents → create or open an agent
#   2. Hover the agent → [...] → Embed → copy  data-agent-id  (format: agt_xxxxxxxx)
#   3. Go to Settings → API Key → copy the key (format: username:password)
#   4. Paste both values below.
#
# DID_API_KEY=your_username:your_password
# DID_AGENT_ID=agt_xxxxxxxx
# Optional fallback portrait (used if agent has no presenter configured):
# DID_SOURCE_URL=https://d-id-public-bucket.s3.amazonaws.com/alice.jpg

# Firebase emulator (debug builds read these after dotenv.load)
# USE_FIREBASE_EMULATOR=true
# AUTH_EMULATOR_HOST=127.0.0.1
# AUTH_EMULATOR_PORT=9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1
# FIRESTORE_EMULATOR_PORT=8080

# Firestore / Storage paths (defaults shown)
# FIRESTORE_USERS_COLLECTION=users
# FIRESTORE_AVATARS_COLLECTION=avatars
# FIRESTORE_SESSIONS_COLLECTION=sessions
# FIRESTORE_FAMILY_COLLECTION=family_members
# FIRESTORE_CREDENTIALS_COLLECTION=credentials
# FIRESTORE_POLICIES_COLLECTION=policies
# FIRESTORE_APPROVALS_COLLECTION=approvals
# STORAGE_AVATARS_ROOT=avatars

# Onboarding
# FACE_UPLOAD_MIN=5
# FACE_UPLOAD_MAX=10

# Optional stock portrait when user has no preview (empty = icon only)
# APP_PLACEHOLDER_PORTRAIT_URL=
